<Solution>
  <!--
    Ceobe.App 只声明 x64，故此处显式映射到 x64；解构建会把 App 输出到 bin/x64/Release/...，
    而显式 `dotnet build src/Ceobe.App/Ceobe.App.csproj` 输出到 bin/Release/...。
    两条路径并存时最容易拿错旧二进制——端到端验证/发布请用 `dotnet publish ... -o dist/app`。
  -->
  <Folder Name="/src/">
    <Project Path="src/Ceobe.App.ViewModels/Ceobe.App.ViewModels.csproj" />
    <Project Path="src/Ceobe.App/Ceobe.App.csproj">
      <Platform Project="x64" />
    </Project>
    <Project Path="src/Ceobe.Cli/Ceobe.Cli.csproj" />
    <Project Path="src/Ceobe.Core/Ceobe.Core.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Ceobe.App.ViewModels.Tests/Ceobe.App.ViewModels.Tests.csproj" />
    <Project Path="tests/Ceobe.Core.Tests/Ceobe.Core.Tests.csproj" />
  </Folder>
</Solution>
