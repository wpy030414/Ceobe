<Project>
  <!--
    版本号唯一权威（AGENTS：CalVer，CI 只读不写）。见 docs/MIGRATION.md 硬契约 7。

    实测硬约束（2026-10-21，.NET SDK 10.0.402）：`<Version>` 不能写成 CalVer 显示形态
    `26.10.21-01`——NuGet 按 SemVer2 解析时拒绝「数字前导零的 prerelease 标识（01）」，
    且该错误被 MSBuild 吞成 `MSB4181: RestoreTask 返回 false 但未记录错误`（无 NU 错误码），
    极难定位。故此处用**点分四段** `YY.MM.DD.HH`，与显示形态一一对应：
        权威（本项目内部）= 26.10.21.01
        展示（Release/tag/关于页）= 26.10.21-01  ← 由 CeobeCalVer 派生规则还原
    与 ADR-017 中「macOS jpackage 只接受 1–3 段数字」同属打包器强加的形态约束。
  -->
  <PropertyGroup>
    <Version>26.10.22</Version>
    <Authors>xrl</Authors>
    <Product>ceobe</Product>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
