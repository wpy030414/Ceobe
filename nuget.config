<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    AGENTS 全局约定「依赖下载优先国内镜像」在 NuGet 上的实测结论（2026-10-21，本机）：
      - nuget.cdn.aliyun-inc.com  内网域名，公网解析失败
      - nuget.cdn.aliyun.com      TLS 握手失败（未能创建 SSL/TLS 安全通道）
      - mirrors.tuna.tsinghua.edu.cn/nuget/  404，清华未提供 NuGet V3 源
      - dotnet SDK 本身：清华 tuna 无 dotnet 镜像，官方 builds.dotnet.microsoft.com 可直连
    故构建期依赖走官方源。运行期下载镜像（BMCLAPI / mcimirror / 清华 Adoptium）是另一回事，
    见 src/Ceobe.Core/Util/Mirrors.cs 与 ADR-012 —— 那部分才是本项目的硬要求。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
