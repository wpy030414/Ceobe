<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>im.xrl</groupId>
  <artifactId>ceobe</artifactId>
  <!-- CalVer（YY.MM.DD-HH）：本处为唯一权威，CI 只读不写；发版时手动 bump 四处 -->
  <version>26.10.15-14</version>
  <packaging>pom</packaging>

  <name>ceobe</name>
  <description>Minecraft 服务器编排系统：多实例管理 / 配置可视化 / Mod 选配 / 内网穿透</description>

  <modules>
    <module>ceobe-core</module>
    <module>ceobe-cli</module>
    <module>ceobe-gui</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <jackson.version>2.18.11</jackson.version>
    <snakeyaml.version>2.7</snakeyaml.version>
    <picocli.version>4.7.7</picocli.version>
    <junit.version>6.1.3</junit.version>
    <javafx.version>25.0.4</javafx.version>
    <atlantafx.version>3.0.0</atlantafx.version>
    <!-- JavaFX 平台分类器：默认 win，由下方 profiles 按 OS/架构覆盖 -->
    <javafx.platform>win</javafx.platform>
    <test.excludedGroups>network</test.excludedGroups>
  </properties>

  <!-- 按构建机平台选择 JavaFX 原生件（win / linux / mac / mac-aarch64） -->
  <profiles>
    <profile>
      <id>javafx-windows</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <properties><javafx.platform>win</javafx.platform></properties>
    </profile>
    <profile>
      <id>javafx-linux</id>
      <activation>
        <os><family>unix</family><name>linux</name></os>
      </activation>
      <properties><javafx.platform>linux</javafx.platform></properties>
    </profile>
    <profile>
      <id>javafx-mac-arm64</id>
      <activation>
        <os><family>mac</family><arch>aarch64</arch></os>
      </activation>
      <properties><javafx.platform>mac-aarch64</javafx.platform></properties>
    </profile>
    <profile>
      <id>javafx-mac-x64</id>
      <activation>
        <os><family>mac</family><arch>x86_64</arch></os>
      </activation>
      <properties><javafx.platform>mac</javafx.platform></properties>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.datatype</groupId>
        <artifactId>jackson-datatype-jsr310</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.yaml</groupId>
        <artifactId>snakeyaml</artifactId>
        <version>${snakeyaml.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
        <classifier>${javafx.platform}</classifier>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-fxml</artifactId>
        <version>${javafx.version}</version>
        <classifier>${javafx.platform}</classifier>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-graphics</artifactId>
        <version>${javafx.version}</version>
        <classifier>${javafx.platform}</classifier>
      </dependency>
      <dependency>
        <groupId>io.github.mkpaz</groupId>
        <artifactId>atlantafx-base</artifactId>
        <version>${atlantafx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <!-- 默认跳过 network 组（真实下载 MC 服务端）；-DexcludedGroups= -Dgroups=network 显式开启 -->
            <excludedGroups>${test.excludedGroups}</excludedGroups>
            <argLine>-Dfile.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-maven-plugin</artifactId>
          <version>0.0.8</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
