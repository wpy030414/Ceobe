<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Ceobe.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Ceobe.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 设计令牌：间距 / 字阶 / 控件样式。顺序在 XamlControlsResources 之后，
                     这样 Typography/Controls 可以 BasedOn 内建样式。 -->
                <ResourceDictionary Source="ms-appx:///Styles/Spacing.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Typography.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局转换器：XAML 里以 StaticResource 引用，故必须在此注册 -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
