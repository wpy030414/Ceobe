<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Controls.ClientListItem"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ceobe.App.Controls">

    <!--
      客户端实例的导航行。与 InstanceListItem 同构（两行文字 + 右上角状态点），
      差异只在第二行内容：客户端显示「1.20.1 · fabric 0.15.11 · 运行中」。
      抽成独立控件而不是复用 InstanceListItem，是因为后者的 Row 类型是服务端的 InstanceRow，
      两种行没有继承关系，硬合并只会让 x:Bind 的类型元数据打架。
    -->
    <Grid Padding="10,10" MinHeight="58" RowSpacing="3"
          AutomationProperties.Name="{x:Bind Row.DisplayName, Mode=OneWay}"
          AutomationProperties.HelpText="{x:Bind Row.DetailLine, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Bind Row.DisplayName, Mode=OneWay}"
                   Style="{StaticResource CeobeBodyStyle}" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" Margin="0,0,24,0" />

        <TextBlock Grid.Row="1" Text="{x:Bind Row.DetailLine, Mode=OneWay}"
                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,24,0" />

        <controls:StatusDot Grid.RowSpan="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,1,-20,0"
                            State="{x:Bind Row.DotState, Mode=OneWay}" />
    </Grid>
</UserControl>
