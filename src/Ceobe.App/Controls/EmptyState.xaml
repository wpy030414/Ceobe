<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 统一的空状态：图标 + 标题 + 说明 + 可选动作。居中放在可用区域内。 -->
    <StackPanel x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="{StaticResource CeobeSpace8}" MaxWidth="420">
        <FontIcon x:Name="Icon" FontSize="32" HorizontalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="TitleText" Style="{StaticResource CeobePageTitleStyle}"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="DescriptionText" Style="{StaticResource CeobeSecondaryTextStyle}"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <ContentPresenter x:Name="ActionHost" HorizontalAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
