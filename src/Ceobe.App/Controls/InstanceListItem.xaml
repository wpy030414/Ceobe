<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Controls.InstanceListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ceobe.App.Controls">

    <!--
       NavigationView 的 MenuItemTemplate 专用。抽成 UserControl 有两个原因：
       1) Window 不是 FrameworkElement，带 Converter 的 x:Bind 不能直接放进 Window 的 DataTemplate；
       2) 容器会被回收复用，Row 变化时通过 DP 回调强制刷新全部 x:Bind。
    -->
    <Grid x:Name="Root" Padding="0,6" MinHeight="44" RowSpacing="2"
          AutomationProperties.Name="{x:Bind Row.DisplayName, Mode=OneWay}"
          AutomationProperties.HelpText="{x:Bind Row.DetailLine, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind Row.DisplayName, Mode=OneWay}"
                       Style="{StaticResource CeobeBodyStyle}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <controls:StatusDot Grid.Column="1" State="{x:Bind Row.State, Mode=OneWay}"
                                VerticalAlignment="Center" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{x:Bind Row.DetailLine, Mode=OneWay}"
                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
