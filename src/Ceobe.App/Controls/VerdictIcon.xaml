<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Controls.VerdictIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw">

    <!--
      穿透通道的三态结论图标：已实测可达 / 无法验证 / 未探测。
      三种颜色都来自主题资源；文字结论由调用方在旁边显示，图标本身只是辅助。
    -->
    <Grid Width="16" Height="16" VerticalAlignment="Center">
        <FontIcon x:Name="OkIcon" Glyph="&#xE73E;" FontSize="14"
                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
        <FontIcon x:Name="WarnIcon" Glyph="&#xE7BA;" FontSize="14"
                  Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
        <FontIcon x:Name="UnknownIcon" Glyph="&#xE946;" FontSize="14"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
    </Grid>
</UserControl>
