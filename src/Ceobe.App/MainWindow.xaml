<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ceobe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ceobe.App.Controls"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <!--
      主壳（2026-10-22 Fluent 2 重构）：
      · 内置 TitleBar + ExtendsContentIntoTitleBar：标题栏与应用同一主题；
      · NavigationView：实例是顶层导航对象，官方侧栏语义（键盘/无障碍/选中指示）；
      · 右侧工作区由 InstanceTabs 提供（实例头 + SelectorBar + 七个分区）；
      · PageBackground 是 Mica 不可用时的纯色回退层，Mica 可用时在 code-behind 隐藏。
    -->
    <Grid x:Name="RootGrid" Background="Transparent">

        <Grid x:Name="PageBackground"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TitleBar x:Name="AppTitleBar" Grid.Row="0"
                      Title="Ceobe"
                      IsBackButtonVisible="False"
                      IsPaneToggleButtonVisible="False"
                      Background="Transparent">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Ceobe.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <NavigationView x:Name="Nav" Grid.Row="1"
                            PaneDisplayMode="Left"
                            IsPaneOpen="True"
                            IsPaneToggleButtonVisible="False"
                            OpenPaneLength="300"
                            CompactPaneLength="48"
                            IsSettingsVisible="False"
                            IsBackButtonVisible="Collapsed"
                            Background="Transparent"
                            MenuItemsSource="{x:Bind NavRows, Mode=OneWay}"
                            SelectionChanged="OnNavSelectionChanged"
                            AutomationProperties.AutomationId="InstanceNav"
                            AutomationProperties.Name="实例导航">

                <NavigationView.PaneHeader>
                    <Grid Padding="16,12,16,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 顶部模式 tab bar：服务端与客户端共用同一套外壳，只换左栏语义与工作区 -->
                        <SelectorBar Grid.Column="0" x:Name="SidebarModeBar"
                                     SelectionChanged="OnModeChanged"
                                     AutomationProperties.Name="工作模式"
                                     AutomationProperties.AutomationId="SidebarModeBar">
                            <SelectorBarItem Text="服务端" Tag="server" />
                            <SelectorBarItem Text="客户端" Tag="client" />
                        </SelectorBar>

                        <ToggleButton Grid.Column="1"
                                      IsChecked="{x:Bind VmList.OnlyRunning, Mode=TwoWay}"
                                      ToolTipService.ToolTip="只看运行中"
                                      AutomationProperties.Name="只看运行中"
                                      AutomationProperties.AutomationId="InstanceFilter">
                            <FontIcon Glyph="&#xE71C;" FontSize="14" />
                        </ToggleButton>

                        <Button Grid.Column="2" Click="OnRefresh"
                                Style="{StaticResource CeobeSubtleIconButtonStyle}"
                                ToolTipService.ToolTip="刷新实例列表 (F5)"
                                AutomationProperties.Name="刷新实例列表"
                                AutomationProperties.AutomationId="InstanceRefreshButton">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                </NavigationView.PaneHeader>

                <NavigationView.MenuItemTemplate>
                    <!--
                      单一内联模板：NavigationView 只有这一种行模板，服务端行与客户端行
                      通过 INavRow 契约共用。不要改成 DataTemplateSelector —— 集合里换类型时
                      容器回收会命中 WinUI 原生层，直接 AV（0xC0000005，无托管栈）。
                    -->
                    <DataTemplate x:DataType="vm:INavRow">
                        <controls:NavListItem Row="{x:Bind}" HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </NavigationView.MenuItemTemplate>
                <NavigationView.MenuItemContainerStyle>
                    <Style TargetType="NavigationViewItem">
                        <Setter Property="Margin" Value="8,3,8,3" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                    </Style>
                </NavigationView.MenuItemContainerStyle>

                <!--
                  PaneFooter 而不是 FooterMenuItems：
                  NavigationView 的 MenuItemTemplate 会被应用到 FooterMenuItems，导致静态项
                  被 InstanceRow 模板错误渲染成空白。PaneFooter 是自定义 UIElement，不参与模板。
                -->
                <NavigationView.PaneFooter>
                    <StackPanel Padding="16,8,16,12" Spacing="4">
                        <Button Click="OnCreateInstanceClick"
                                Style="{StaticResource CeobePaneActionButtonStyle}"
                                AutomationProperties.Name="新建实例"
                                AutomationProperties.AutomationId="NewInstanceButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock x:Name="CreateButtonText" Text="新建实例" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnSettingsClick"
                                Style="{StaticResource CeobePaneActionButtonStyle}"
                                AutomationProperties.Name="设置"
                                AutomationProperties.AutomationId="SettingsButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Setting" />
                                <TextBlock Text="设置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </NavigationView.PaneFooter>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 工作区宿主。显式 Stretch：ContentControl 默认是 Left/Top，
                         页面里的 * 行会因此塌成 0 高度。 -->
                    <ContentControl x:Name="ContentHost" Grid.Row="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />

                    <Border Grid.Row="1" Padding="24,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
