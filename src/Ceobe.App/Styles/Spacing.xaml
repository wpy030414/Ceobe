<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      4px 网格。WinUI / Fluent 2 的间距档位是 4 / 8 / 12 / 16 / 24：
      所有页面与卡片必须从这里取值，不要在 XAML 里再写 7 / 10 / 14 / 18 这类散数。
    -->
    <x:Double x:Key="CeobeSpace4">4</x:Double>
    <x:Double x:Key="CeobeSpace8">8</x:Double>
    <x:Double x:Key="CeobeSpace12">12</x:Double>
    <x:Double x:Key="CeobeSpace16">16</x:Double>
    <x:Double x:Key="CeobeSpace24">24</x:Double>

    <!-- 页面外边距（Windows 11 大屏规范 24） -->
    <Thickness x:Key="CeobePagePadding">24</Thickness>
    <!-- 卡片内边距 -->
    <Thickness x:Key="CeobeCardPadding">16</Thickness>
    <!-- 表格行左右内边距：表头与行必须共用，否则列会错位 -->
    <Thickness x:Key="CeobeTableRowPadding">12,0</Thickness>

    <!-- 表单/设置页的最大阅读宽度，避免超宽窗口里输入框拉成一整行 -->
    <x:Double x:Key="CeobeContentMaxWidth">960</x:Double>
    <x:Double x:Key="CeobeFormMaxWidth">720</x:Double>
</ResourceDictionary>
