<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      字体与字阶。
      WinUI 3 的 FontFamily 不是 CSS：它不接受 "Cascadia Mono,Consolas" 这种逗号回退列表。
      未安装 Cascadia 的机器会整串匹配失败并静默退回 UI 字体，所以这里固定用 Windows
      自带的 Consolas——等宽、可读、零依赖。
    -->
    <FontFamily x:Key="CeobeMonoFont">Consolas</FontFamily>

    <!-- 页标题：Subtitle 20/28。实例名与空状态标题使用。 -->
    <Style x:Key="CeobePageTitleStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SubtitleTextBlockStyle}" />

    <!-- 区块标题：Body Strong 14/20。 -->
    <Style x:Key="CeobeSectionTitleStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

    <!-- 正文。 -->
    <Style x:Key="CeobeBodyStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}" />

    <!-- 正文次级色：说明、描述。 -->
    <Style x:Key="CeobeSecondaryTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 辅助文字：Caption 12/16。 -->
    <Style x:Key="CeobeCaptionStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}" />

    <Style x:Key="CeobeCaptionSecondaryStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>
