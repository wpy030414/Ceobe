<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ClientLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <!--
      日志与崩溃（设计稿 06）。主视觉是结论，日志退为证据：
      「哪个 Mod、为什么、怎么办」放左边第一眼，原始输出放右边供核对。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="日志" Margin="24,8,24,0"
                   Style="{StaticResource CeobeSectionTitleStyle}" />
    <Grid Grid.Row="1" Padding="24,8,24,24" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 崩溃诊断 ===== -->
        <Border Grid.Column="0" Style="{StaticResource CeobeCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="崩溃诊断" Style="{StaticResource CeobeSectionTitleStyle}" />
                        <TextBlock Text="{x:Bind Vm.CrashTime, Mode=OneWay}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                    </Grid>

                    <TextBlock Text="{x:Bind Vm.CrashHeadline, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <!-- 原始异常行：懂行的人要能核对，不懂的人可以跳过 -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10"
                            Visibility="{x:Bind HasException, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind Vm.ExceptionLine, Mode=OneWay}"
                                   FontFamily="{StaticResource CeobeMonoFont}" FontSize="11"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Border>

                    <TextBlock Text="直接原因" Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                    <TextBlock Text="{x:Bind Vm.CrashCause, Mode=OneWay}"
                               Style="{StaticResource CeobeSecondaryTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="下一步" Style="{StaticResource CeobeCaptionSecondaryStyle}"
                               Visibility="{x:Bind HasActions, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{x:Bind Vm.Actions, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="8" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="•" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap"
                                               Style="{StaticResource CeobeBodyStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Text="最近崩溃报告" Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Vm.RecentCrashes, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClientCrashRow">
                                <Grid Height="28" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind Time}" Width="96"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                                    <TextBlock Text="{x:Bind FileName}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== 运行日志 ===== -->
        <Border Grid.Column="1" Style="{StaticResource CeobeCardStyle}" Padding="16,12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="运行日志" Style="{StaticResource CeobeSectionTitleStyle}" />
                        <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="清空显示" Click="OnClear" />
                    <Button Grid.Column="2" Content="打开日志文件" Click="OnOpenLog" />
                </Grid>

                <ListView x:Name="LogList" Grid.Row="1"
                          ItemsSource="{x:Bind Vm.Lines, Mode=OneWay}"
                          SelectionMode="None"
                          AutomationProperties.Name="游戏运行日志">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"
                               BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="MinHeight" Value="18" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontFamily="{StaticResource CeobeMonoFont}"
                                       FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
