<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ClientModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="ModRowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </UserControl.Resources>

    <!--
      Mod 管理（设计稿 03）：左侧表格，右侧详情。
      「依赖健康」是列级信息——它决定游戏能不能起来，不该藏进详情面板。
    -->
    <Grid Padding="24,8,24,24" RowSpacing="12" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="搜索 Mod 名称 / 标识 / 文件名"
                     Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="搜索已安装 Mod" />

            <ComboBox Grid.Column="1" MinWidth="130" SelectedIndex="0"
                      SelectionChanged="OnFilterChanged"
                      AutomationProperties.Name="筛选 Mod">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="有缺失" />
                <ComboBoxItem Content="已停用" />
            </ComboBox>

            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                       Style="{StaticResource CeobeCaptionSecondaryStyle}"
                       Text="{x:Bind CountsText}" />

            <Button Grid.Column="3" Content="导入本地 jar" Click="OnImport"
                    AutomationProperties.Name="导入本地 jar" />
        </Grid>

        <!-- 依赖诊断横幅：只报「确定缺什么」，不猜不兼容 -->
        <InfoBar Grid.Row="1" IsOpen="{x:Bind Vm.HasHealthBanner, Mode=OneWay}"
                 Severity="Warning" IsClosable="False"
                 Title="依赖诊断"
                 Message="{x:Bind Vm.HealthDetail, Mode=OneWay}" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 表格 -->
            <Border Grid.Column="0" Style="{StaticResource CeobeCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="34" Padding="12,0" ColumnSpacing="12"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                        <TextBlock Grid.Column="1" Text="版本" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                        <TextBlock Grid.Column="2" Text="依赖健康" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                        <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                        <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Mods, Mode=OneWay}"
                              SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource ModRowStyle}"
                              AutomationProperties.Name="已安装 Mod">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClientModRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FileName}"
                                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Version}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource CeobeMonoFont}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}" />

                                    <TextBlock Grid.Column="2" Text="{x:Bind Health}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}" />

                                    <TextBlock Grid.Column="3" Text="{x:Bind StateLabel}" VerticalAlignment="Center"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}" />

                                    <Button Grid.Column="4" Content="{x:Bind ToggleLabel}"
                                            Click="OnToggle" Tag="{x:Bind}"
                                            MinWidth="0" Padding="8,2" FontSize="11"
                                            AutomationProperties.Name="{x:Bind ToggleLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="1" Text="{x:Bind Vm.EmptyHint, Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                </Grid>
            </Border>

            <!-- 详情 -->
            <Border Grid.Column="1" Style="{StaticResource CeobeCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Vm.Selected.Title, Mode=OneWay}"
                                   Style="{StaticResource CeobeSectionTitleStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Vm.Selected.FileName, Mode=OneWay}"
                                   FontFamily="{StaticResource CeobeMonoFont}"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                   TextWrapping="Wrap" />

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid ColumnSpacing="8">
                            <TextBlock Text="当前版本" Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                            <TextBlock Text="{x:Bind Vm.Selected.Version, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       FontFamily="{StaticResource CeobeMonoFont}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <TextBlock Text="文件大小" Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                            <TextBlock Text="{x:Bind Vm.Selected.SizeLabel, Mode=OneWay}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.Selected.DependencyDetail, Mode=OneWay}"
                                   Style="{StaticResource CeobeSecondaryTextStyle}"
                                   TextWrapping="Wrap" />

                        <Button Content="删除这个 jar" Click="OnDelete"
                                Style="{StaticResource CeobeDangerButtonStyle}"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="停用只是改名为 .jar.disabled，随时可以再启用；删除是不可逆的。"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
