<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ClientSavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <!--
      存档（设计稿预留项，本轮补齐）。本页只做「备份 / 还原」：
      存档是玩家唯一不可再生的资产，启动器不该在同一个页面里提供「删除世界」。
    -->
    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="存档" VerticalAlignment="Center"
                       Style="{StaticResource CeobeSectionTitleStyle}" />
            <Button Grid.Column="1" Content="打开存档目录" Click="OnOpenFolder" />
            <Button Grid.Column="2" Content="还原备份…" Click="OnRestore" />
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="{x:Bind Vm.ShowError, Mode=OneWay}"
                 Severity="Error"
                 Message="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                 IsClosable="False" />
        <InfoBar Grid.Row="1" IsOpen="{x:Bind Vm.ShowSuccess, Mode=OneWay}"
                 Severity="Success"
                 Message="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                 IsClosable="False" />

        <Border Grid.Row="2" Style="{StaticResource CeobeCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="34" Padding="16,0" ColumnSpacing="12"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="世界" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                    <TextBlock Grid.Column="1" Text="最后游玩" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                    <TextBlock Grid.Column="2" Text="模式" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                    <TextBlock Grid.Column="3" Text="大小" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                    <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource CeobeTableHeaderCellStyle}" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Saves, Mode=OneWay}"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource CeobeTableRowStyle}"
                          AutomationProperties.Name="存档列表">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClientSaveCard">
                            <Grid ColumnSpacing="12" Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind LevelName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Folder}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind LastPlayedLabel}"
                                           Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind GameMode}"
                                           Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeLabel}"
                                           Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="4" Content="备份" Tag="{x:Bind}" Click="OnBackup"
                                        MinWidth="0" Padding="10,3" FontSize="11"
                                        AutomationProperties.Name="备份存档" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1" Text="{x:Bind Vm.Hint, Mode=OneWay}" Margin="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                           Style="{StaticResource CeobeCaptionSecondaryStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
