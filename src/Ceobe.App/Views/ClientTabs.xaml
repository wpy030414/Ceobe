<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ClientTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ceobe.App.Views">

    <!--
      客户端实例工作区：实例头 + 分区选择器 + 七个页面。
      与服务端工作区同构（InstanceTabs），差异只在分区内容：
      启动 / Mod / 资源包 / 存档 / 服务器 / 日志 / 设置。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 实例头 ===== -->
        <Grid Grid.Row="0" Padding="24,16,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind InstanceName}"
                           Style="{StaticResource CeobePageTitleStyle}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind LaunchVm.StatusLine, Mode=OneWay}"
                           Style="{StaticResource CeobeCaptionSecondaryStyle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{x:Bind LaunchVm.StartStopLabel, Mode=OneWay}"
                    Click="OnStartStop"
                    IsEnabled="{x:Bind LaunchVm.CanStop, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind LaunchVm.StartStopLabel, Mode=OneWay}" />

            <DropDownButton Grid.Column="2" VerticalAlignment="Center"
                            Style="{StaticResource CeobeSubtleIconButtonStyle}"
                            ToolTipService.ToolTip="更多客户端操作"
                            AutomationProperties.Name="更多客户端操作">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="打开游戏目录" Click="OnOpenFolder">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="OpenFile" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="强制结束游戏进程" Click="OnKill">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Cancel" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="删除实例" Click="OnDelete"
                                        Style="{StaticResource CeobeDangerMenuFlyoutItemStyle}">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Delete" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- ===== 分区选择器 ===== -->
        <SelectorBar x:Name="SectionBar" Grid.Row="1" Margin="24,0,24,8"
                     SelectionChanged="OnSectionChanged"
                     AutomationProperties.AutomationId="ClientWorkspaceSections"
                     AutomationProperties.Name="客户端分区">
            <SelectorBarItem Text="启动" Tag="launch">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Mod" Tag="mods">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="资源包" Tag="packs">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="存档" Tag="saves">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="服务器" Tag="servers">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="日志" Tag="log">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE756;" FontSize="14" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="设置" Tag="settings">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- ===== 页面宿主 ===== -->
        <Grid Grid.Row="2">
            <views:ClientLaunchPage x:Name="LaunchTab" />
            <views:ClientModsPage x:Name="ModsTab" Visibility="Collapsed" />
            <views:ClientPacksPage x:Name="PacksTab" Visibility="Collapsed" />
            <views:ClientSavesPage x:Name="SavesTab" Visibility="Collapsed" />
            <views:ClientServersPage x:Name="ServersTab" Visibility="Collapsed" />
            <views:ClientLogPage x:Name="LogTab" Visibility="Collapsed" />
            <views:ClientSettingsPage x:Name="SettingsTab" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
