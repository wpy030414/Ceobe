<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ceobe.App.Controls">

    <UserControl.Resources>
        <!-- 日志行：不拉伸（保留长行的横向滚动），不加额外高度。 -->
        <Style x:Key="LogRowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="控制台" Margin="24,8,24,0"
                   Style="{StaticResource CeobeSectionTitleStyle}" />
    <Grid Grid.Row="1" Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 状态/错误条 -->
        <InfoBar Grid.Row="0"
                 IsOpen="{x:Bind ShowBanner, Mode=OneWay}"
                 Severity="{x:Bind BannerSeverity, Mode=OneWay}"
                 Title="{x:Bind Vm.StatusText, Mode=OneWay}"
                 IsClosable="True" />

        <!-- 日志卡：头部工具条 + 日志正文 + 命令行 -->
        <Border Grid.Row="1" Style="{StaticResource CeobeCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部：标题 + 外部托管提示 + 跟随/复制/清空 -->
                <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="8"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="日志"
                               Style="{StaticResource CeobeSectionTitleStyle}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="{x:Bind HostedHint, Mode=OneWay}"
                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="8,0,0,0" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <ToggleButton Content="跟随"
                                      IsChecked="{x:Bind Vm.Follow, Mode=TwoWay}"
                                      ToolTipService.ToolTip="滚动到最新日志"
                                      AutomationProperties.Name="跟随最新日志" />
                        <Button Content="复制" Click="OnCopyLog"
                                ToolTipService.ToolTip="复制全部日志"
                                AutomationProperties.Name="复制全部日志" />
                        <Button Content="清空" Click="OnClear"
                                ToolTipService.ToolTip="清空当前显示（不影响磁盘日志）"
                                AutomationProperties.Name="清空日志显示" />
                    </StackPanel>
                </Grid>

                <!-- 日志正文：虚拟化 ListView；空列表时显示空状态。 -->
                <Grid Grid.Row="1">
                    <ListView x:Name="LogList"
                              ItemsSource="{x:Bind Vm.Lines, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ItemContainerStyle="{StaticResource LogRowStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="服务端日志"
                              AutomationProperties.AutomationId="ConsoleLogList">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           FontFamily="{StaticResource CeobeMonoFont}"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           IsTextSelectionEnabled="True" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <controls:EmptyState x:Name="LogEmpty"
                                         Glyph="&#xE756;"
                                         Title="还没有日志"
                                         Description="启动服务器后，日志会实时出现在这里。"
                                         Visibility="{x:Bind ShowEmptyLog, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 命令行 -->
                <Grid Grid.Row="2" Padding="16,12" ColumnSpacing="8"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="InputBox"
                             PlaceholderText="输入服务端命令，如 say 你好 / op 玩家名"
                             AutomationProperties.Name="服务端命令"
                             AutomationProperties.AutomationId="ConsoleInput"
                             Text="{x:Bind Vm.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind Vm.CanSend, Mode=OneWay}"
                             KeyDown="OnInputKeyDown" />
                    <Button Grid.Column="1" Content="发送" Click="OnSend"
                            IsEnabled="{x:Bind Vm.CanSend, Mode=OneWay}"
                            ToolTipService.ToolTip="发送命令 (Enter)"
                            AutomationProperties.Name="发送命令" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
