<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      控制台页：实时日志 + 命令下发 + 启停 + 删除。
      业务全在 ConsoleViewModel（闸门 C），本页只做绑定与手势转发。
      布局对齐 Java 版 ConsolePane：工具条 / 日志区 / 输入行。
    -->
    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条：状态徽标 + 跟随 + 启停删 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{x:Bind Vm.IsLive, Mode=OneWay, Converter={StaticResource LiveToBrush}}" />
                <TextBlock Text="{x:Bind Vm.StateLabel, Mode=OneWay}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ToggleSwitch Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,12,0"
                          IsOn="{x:Bind Vm.Follow, Mode=TwoWay}"
                          OnContent="跟随" OffContent="不跟随" FontSize="12" MinWidth="0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="启动" Click="OnStart"
                        IsEnabled="{x:Bind Vm.CanStart, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="停止" Click="OnStop"
                        IsEnabled="{x:Bind Vm.CanStop, Mode=OneWay}" />
                <Button Content="清空显示" Click="OnClear" />
                <!-- 删除是不可逆操作：View 层必须弹三选确认（仅移除 / 连数据删除 / 取消），
                     VM 只接受已决定好的 purge 模式，这样删除逻辑可被单测覆盖 -->
                <Button Content="删除实例" Click="OnDelete"
                        IsEnabled="{x:Bind Vm.CanDelete, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- 状态/错误条 -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ShowBanner, Mode=OneWay}"
                 Severity="{x:Bind BannerSeverity, Mode=OneWay}"
                 Title="{x:Bind Vm.StatusText, Mode=OneWay}"
                 IsClosable="False" />

        <!-- 日志区：等宽字体，禁换行（Java 版 setWrapText(false)，长行横向滚动更易读）-->
        <Border Grid.Row="2" CornerRadius="6"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Vm.Lines, Mode=OneWay}" Padding="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono,Consolas"
                                       FontSize="12" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 输入行 -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="InputBox"
                     PlaceholderText="输入服务端命令，如 say 你好 / op 玩家名"
                     Text="{x:Bind Vm.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{x:Bind Vm.CanSend, Mode=OneWay}"
                     KeyDown="OnInputKeyDown" />
            <Button Grid.Column="1" Content="发送" Click="OnSend"
                    IsEnabled="{x:Bind Vm.CanSend, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- 外部托管提示（CLI start -d 起的服，GUI 只是旁观者）-->
        <TextBlock Grid.Row="4" FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind HostedHint, Mode=OneWay}" />
    </Grid>
</UserControl>
