<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Ceobe.App.Views.CreateClientDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ceobe.App.ViewModels"
    Title="新建客户端实例"
    PrimaryButtonText="创建并下载"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <!--
      新建客户端实例（设计稿 02）：版本 × 加载器一次选完。
      右侧的「将下载 / Java / servers.dat」是这张对话框存在的理由——
      把 PCL/HMCL 里「装完才发现版本不对、Java 不对」的成本挪到创建之前。
    -->
    <Grid Width="840" Height="500" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 版本 ===== -->
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Minecraft 版本" Style="{StaticResource CeobeSectionTitleStyle}" />
                <TextBlock Text="{x:Bind Vm.VersionHint, Mode=OneWay}" HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource CeobeCaptionSecondaryStyle}"
                           TextTrimming="CharacterEllipsis" MaxWidth="170" />
            </Grid>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind Vm.Versions, Mode=OneWay}"
                      SelectedItem="{x:Bind Vm.SelectedVersion, Mode=TwoWay}"
                      SelectionMode="Single"
                      ItemContainerStyle="{StaticResource CeobeTableRowStyle}"
                      AutomationProperties.Name="Minecraft 版本列表">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClientVersionRow">
                        <Grid Height="36" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Id}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource CeobeMonoFont}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind TypeLabel}" VerticalAlignment="Center"
                                       Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ===== 加载器 + 名称 + 摘要 ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="加载器" Style="{StaticResource CeobeSectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Vm.Loaders, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClientLoaderOption">
                                <ToggleButton Tag="{x:Bind}" Click="OnSelectLoader"
                                              IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                              IsEnabled="{x:Bind IsSelectable}"
                                              Width="150" Height="60"
                                              HorizontalContentAlignment="Left"
                                              Padding="10,6"
                                              AutomationProperties.Name="{x:Bind Label}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                                   TextWrapping="Wrap" FontSize="10.5" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="加载器版本" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind Vm.LoaderVersions, Mode=OneWay}"
                              SelectedItem="{x:Bind Vm.SelectedLoaderVersion, Mode=TwoWay}"
                              AutomationProperties.Name="加载器版本" />
                    <TextBox Grid.Column="1" Header="实例名称"
                             Text="{x:Bind Vm.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="实例名称" />
                </Grid>

                <!-- 摘要：创建前就把「将下载什么、复用哪个 Java、写几台服务器」说清楚 -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="12">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="将下载" Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                            <TextBlock Text="{x:Bind Vm.SummaryDownload, Mode=OneWay}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Java 运行时" Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                            <TextBlock Text="{x:Bind Vm.SummaryJava, Mode=OneWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="自动配置" Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                            <TextBlock Text="{x:Bind Vm.SummaryServers, Mode=OneWay}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380" />
                        </Grid>
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="{x:Bind Vm.HasError, Mode=OneWay}"
                         Severity="Error" Title="创建失败"
                         Message="{x:Bind Vm.ErrorText, Mode=OneWay}" IsClosable="False" />

                <StackPanel Spacing="6"
                            Visibility="{x:Bind Vm.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Value="{x:Bind Vm.ProgressValue, Mode=OneWay}" Maximum="100" Height="4" />
                    <TextBlock Text="{x:Bind Vm.ProgressText, Mode=OneWay}"
                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Text="{x:Bind Vm.InstallPath, Mode=OneWay}"
                           FontFamily="{StaticResource CeobeMonoFont}" FontSize="11"
                           Style="{StaticResource CeobeCaptionSecondaryStyle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
