<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Ceobe.App.Views.CreateInstanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ceobe.App.ViewModels"
    Title="新建实例"
    PrimaryButtonText="创建"
    CloseButtonText="取消"
    DefaultButton="Primary"
    CornerRadius="{StaticResource OverlayCornerRadius}"
    IsPrimaryButtonEnabled="{x:Bind Vm.CanSubmit, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick"
    Opened="OnOpened">

    <!--
      单页表单（主人拍板：不打散成三步向导）。
      游戏版本是下拉：标题为版本号、副标题为发布日期；默认选中最新正式版。
    -->
    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MinWidth="460">
            <TextBox x:Name="NameBox"
                     Header="实例名（小写字母/数字/_/-）"
                     PlaceholderText="如 my-survival"
                     Text="{x:Bind Vm.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="实例名" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox x:Name="TypeBox" Grid.Row="0" Grid.Column="0"
                          Header="服务端类型" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind Vm.Types}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind Vm.SelectedTypeOption, Mode=TwoWay}"
                          SelectionChanged="OnTypeChanged"
                          AutomationProperties.Name="服务端类型" />

                <ComboBox x:Name="VersionBox" Grid.Row="0" Grid.Column="1"
                          Header="游戏版本" HorizontalAlignment="Stretch"
                          MinHeight="56"
                          ItemsSource="{x:Bind Vm.GameVersions, Mode=OneWay}"
                          SelectedItem="{x:Bind Vm.SelectedGameVersion, Mode=TwoWay}"
                          IsEnabled="{x:Bind Vm.VersionsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}"
                          AutomationProperties.Name="游戏版本">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameVersionOption">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind Id}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ReleasedLabel}"
                                           Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Grid.Row="1" Grid.Column="0"
                         Header="加载器版本（Fabric / NeoForge）"
                         PlaceholderText="留空 = 最新 stable"
                         Text="{x:Bind Vm.LoaderVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{x:Bind Vm.NeedsLoaderVersion, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.Name="加载器版本" />

                <NumberBox Grid.Row="1" Grid.Column="1"
                           Header="内存上限 (MB)"
                           Value="{x:Bind Vm.MemoryMbDouble, Mode=TwoWay}"
                           Minimum="512" Maximum="65536"
                           SpinButtonPlacementMode="Inline"
                           SmallChange="512" LargeChange="1024"
                           AutomationProperties.Name="内存上限" />

                <CheckBox Grid.Row="2" Grid.Column="0"
                          Content="自动选取空闲端口"
                          IsChecked="{x:Bind Vm.AutoPort, Mode=TwoWay}" />

                <NumberBox Grid.Row="2" Grid.Column="1"
                           Header="服务器端口"
                           Value="{x:Bind Vm.PortDouble, Mode=TwoWay}"
                           Minimum="1" Maximum="65535"
                           IsEnabled="{x:Bind Vm.AutoPort, Mode=OneWay, Converter={StaticResource InverseBool}}"
                           AutomationProperties.Name="服务器端口" />

                <!-- 版本清单状态：加载中 / 失败可重试 -->
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind Vm.VersionsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ProgressRing Width="16" Height="16"
                                      IsActive="{x:Bind Vm.VersionsLoading, Mode=OneWay}" />
                        <TextBlock Text="正在加载游戏版本…"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <InfoBar IsOpen="{x:Bind Vm.HasVersionsError, Mode=OneWay}"
                             Severity="Error" IsClosable="False"
                             Title="{x:Bind Vm.VersionsError, Mode=OneWay}" />

                    <Button Content="重试加载版本" Click="OnReloadVersions"
                            HorizontalAlignment="Left"
                            Visibility="{x:Bind Vm.HasVersionsError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>

            <CheckBox Content="开启白名单（只有名单内的玩家能进服）"
                      IsChecked="{x:Bind Vm.WhitelistEnabled, Mode=TwoWay}" />

            <InfoBar IsOpen="{x:Bind Vm.HasError, Mode=OneWay}"
                     Severity="Error" IsClosable="False"
                     Title="{x:Bind Vm.StatusText, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind Vm.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                           Style="{StaticResource CeobeCaptionSecondaryStyle}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
