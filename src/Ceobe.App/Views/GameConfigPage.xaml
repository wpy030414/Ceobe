<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.GameConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ceobe.App.Controls"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <UserControl.Resources>
        <!-- 单行配置项：类型化控件由 PropFieldRow 内部选择，避免隐藏控件回写坏值。 -->
        <DataTemplate x:Key="PropRowTemplate" x:DataType="vm:PropField">
            <controls:PropFieldRow Field="{x:Bind}" />
        </DataTemplate>

        <!-- 数据包列表的一行：名称 + 切换。 -->
        <DataTemplate x:Key="PackRowTemplate" x:DataType="x:String">
            <Grid ColumnSpacing="8" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="切换" Tag="{x:Bind}" Click="OnTogglePack"
                        AutomationProperties.Name="切换数据包启用状态" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--
      游戏配置页（整改项 5）：server.properties 三级视图 + 资源包/数据包复合控件。
      业务在 GameConfigViewModel（闸门 C 可单测），本页只做绑定。
    -->
    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 视图切换 + 分组 + 搜索 -->
        <Border Grid.Row="0" Style="{StaticResource CeobeCardStyle}" Padding="16,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButtons Grid.Column="0" MaxColumns="3"
                              SelectedIndex="{x:Bind ViewIndex, Mode=TwoWay}">
                    <RadioButton Content="常用" />
                    <RadioButton Content="分类" />
                    <RadioButton Content="原始" />
                </RadioButtons>

                <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.GroupNavs}"
                          DisplayMemberPath="Name" SelectedValuePath="Name"
                          SelectedValue="{x:Bind Vm.SelectedGroup, Mode=TwoWay}"
                          Visibility="{x:Bind ShowGroupNav, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                          MinWidth="160" VerticalAlignment="Center"
                          AutomationProperties.Name="配置分组" />

                <AutoSuggestBox Grid.Column="2" PlaceholderText="搜索配置项（键名/中文名/分组）"
                                QueryIcon="Find" VerticalAlignment="Center"
                                Text="{x:Bind Vm.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="搜索配置项" />
            </Grid>
        </Border>

        <!-- 无 server.properties 时的引导 -->
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ShowNoProps, Mode=OneWay}" Severity="Informational"
                 IsClosable="False" Title="{x:Bind Vm.StatusText, Mode=OneWay}" />

        <!-- 字段列表 + 资源包/数据包（同一个滚动区） -->
        <ScrollViewer Grid.Row="2" x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource CeobeCardStyle}" Padding="0">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="配置项"
                                       Style="{StaticResource CeobeTableHeaderCellStyle}" />
                            <TextBlock Grid.Column="1" Text="值"
                                       Style="{StaticResource CeobeTableHeaderCellStyle}" />
                            <TextBlock Grid.Column="2" Text="校验"
                                       Style="{StaticResource CeobeTableHeaderCellStyle}" />
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind Vm.Fields, Mode=OneWay}"
                                       ItemTemplate="{StaticResource PropRowTemplate}" />
                    </StackPanel>
                </Border>

                <!-- 整改项 5：4 个 resource-pack 键 + 数据包多选，语义化成一个面板 -->
                <Expander Header="资源包与数据包" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="0,4,0,0">
                        <TextBlock Text="服务器资源包"
                                   Style="{StaticResource CeobeSectionTitleStyle}" />
                        <Border Style="{StaticResource CeobeCardStyle}" Padding="0">
                            <ItemsRepeater ItemsSource="{x:Bind Vm.ResourcePackFields, Mode=OneWay}"
                                           ItemTemplate="{StaticResource PropRowTemplate}" />
                        </Border>

                        <TextBlock Text="数据包（initial-enabled-packs / initial-disabled-packs）"
                                   Style="{StaticResource CeobeSectionTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CeobeCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="已启用" Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                                    <ListView ItemsSource="{x:Bind Vm.EnabledPacks, Mode=OneWay}"
                                              SelectionMode="None" MaxHeight="180"
                                              ItemTemplate="{StaticResource PackRowTemplate}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CeobeCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="未启用" Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                                    <ListView ItemsSource="{x:Bind Vm.DisabledPacks, Mode=OneWay}"
                                              SelectionMode="None" MaxHeight="180"
                                              ItemTemplate="{StaticResource PackRowTemplate}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作条：保存是唯一 Accent -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                       Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button Grid.Column="1" Content="放弃改动" Click="OnDiscard"
                    IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}" />
            <Button Grid.Column="2" Content="保存" Click="OnSave"
                    IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
