<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.GameConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <!--
      游戏配置页（整改项 5）：server.properties 三级视图。
      Java 版把 7 组 60+ 键平铺，训练员反馈「杂乱且繁多」；这里改成
      常用 / 分类 / 原始 三档 + 搜索，并把「改完要不要重启」显示出来。
      业务在 GameConfigViewModel（闸门 C 可单测），本页只做绑定。
    -->
    <Grid RowSpacing="10" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 视图切换 + 搜索 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButtons Grid.Column="0" MaxColumns="3" SelectedIndex="{x:Bind ViewIndex, Mode=TwoWay}">
                <RadioButton Content="常用" />
                <RadioButton Content="分类" />
                <RadioButton Content="原始" />
            </RadioButtons>
            <!-- 分类视图的分组导航（其他视图时隐藏） -->
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.GroupNavs}"
                      DisplayMemberPath="Name" SelectedValuePath="Name"
                      SelectedValue="{x:Bind Vm.SelectedGroup, Mode=TwoWay}"
                      Visibility="{x:Bind ShowGroupNav, Mode=OneWay}" MinWidth="140"
                      VerticalAlignment="Center" />
            <AutoSuggestBox Grid.Column="2" PlaceholderText="搜索配置项（键名/中文名/分组）"
                            QueryIcon="Find" VerticalAlignment="Center"
                            Text="{x:Bind Vm.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- 无 server.properties 时的引导 -->
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ShowNoProps, Mode=OneWay}" Severity="Informational"
                 IsClosable="False" Title="{x:Bind Vm.StatusText, Mode=OneWay}" />

        <!-- 字段列表 -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{x:Bind Vm.Fields, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropField">
                        <Border Padding="0,8" BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 左：中文名 + 原始键 + 生效方式 -->
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind Zh}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Key}" FontSize="11" FontFamily="Cascadia Mono,Consolas"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <!-- 整改项 5：改完要不要重启，是一等公民 -->
                                    <TextBlock Text="{x:Bind PolicyLabel}" FontSize="11"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <!-- 中：按类型分派的输入控件（Bool/Int/Enum/String 各一种，互斥显示）
                                     bool 不能直接绑 Visibility（类型不符），经 BoolToVis 转换器；
                                     VM 侧只给纯 bool，UI 依赖隔离在 View 层 -->
                                <Grid Grid.Column="1">
                                    <CheckBox IsChecked="{x:Bind BoolValue, Mode=TwoWay}"
                                              IsEnabled="{x:Bind IsEditable}"
                                              Visibility="{x:Bind IsBool, Converter={StaticResource BoolToVis}}" />
                                    <NumberBox Value="{x:Bind NumberValueDouble, Mode=TwoWay}"
                                               Minimum="{x:Bind MinDouble}" Maximum="{x:Bind MaxDouble}"
                                               SpinButtonPlacementMode="Compact"
                                               Visibility="{x:Bind IsInt, Converter={StaticResource BoolToVis}}" />
                                    <ComboBox ItemsSource="{x:Bind Options}"
                                              SelectedItem="{x:Bind Value, Mode=TwoWay}"
                                              Visibility="{x:Bind IsEnum, Converter={StaticResource BoolToVis}}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{x:Bind IsReadOnly}"
                                             Visibility="{x:Bind IsString, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <!-- 右：校验错误提示 -->
                                <TextBlock Grid.Column="2" Text="{x:Bind ValidationError}" MaxWidth="180"
                                           TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部操作条 -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                       Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="放弃改动" Click="OnDiscard" IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}" />
            <Button Grid.Column="2" Content="保存" Click="OnSave" IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
