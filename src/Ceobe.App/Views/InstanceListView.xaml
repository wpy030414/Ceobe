<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.InstanceListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <!--
      实例列表抽成独立 UserControl 的原因（不是过度设计）：
      WinUI 3 的 Window 不是 FrameworkElement，而 x:Bind + Converter 的生成代码会调
      SetConverterLookupRoot(this)，要求根是 FrameworkElement——直接在 MainWindow.xaml
      的 DataTemplate 里用 LiveToBrush 转换器会编译失败（CS1503）。
      放进 UserControl 后，转换器查找根变成这个 UserControl（它是 FrameworkElement），问题解决。
    -->
    <ListView x:Name="List"
              ItemsSource="{x:Bind VmList.Rows, Mode=OneWay}"
              SelectedValue="{x:Bind VmList.SelectedName, Mode=TwoWay}"
              SelectedValuePath="Name"
              SelectionMode="Single" Padding="8,0,8,8">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:InstanceRow">
                <Grid Padding="4,6" RowSpacing="2"
                      AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind Detail, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind DisplayName, Mode=OneWay}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <!-- 运行中给个绿点，一眼看出哪个服开着（必须 OneWay：VM 就地更新行的 IsLive） -->
                        <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                                 Margin="6,0,0,0"
                                 Fill="{x:Bind IsLive, Mode=OneWay, Converter={StaticResource LiveToBrush}}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{x:Bind Detail, Mode=OneWay}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
