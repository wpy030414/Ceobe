<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.InstanceTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ceobe.App.Views">

    <!--
      实例页签容器。对齐 Java 版 MainView 的 TabPane，七页齐全：
      控制台 / 服务器配置 / 游戏配置 / Mod / 整合包 / 玩家 / 穿透。
      每页都是「无参构造 + Load(vm)」：XAML 以 x:Name 声明，VM 由 code-behind 注入，
      业务全在 ViewModels（闸门 C：可无窗口单测）。

      页签顺序即使用频率：先看日志，再改配置，最后才是导入与联机。
    -->
    <TabView x:Name="Tabs" IsAddTabButtonVisible="False">
        <TabViewItem Header="控制台" IsClosable="False">
            <views:ConsolePage x:Name="ConsoleTab" />
        </TabViewItem>
        <TabViewItem Header="服务器配置" IsClosable="False">
            <views:ServerPage x:Name="ServerTab" />
        </TabViewItem>
        <TabViewItem Header="游戏配置" IsClosable="False">
            <views:GameConfigPage x:Name="GameTab" />
        </TabViewItem>
        <TabViewItem Header="Mod" IsClosable="False">
            <views:ModsPage x:Name="ModsTab" />
        </TabViewItem>
        <TabViewItem Header="整合包" IsClosable="False">
            <views:ModpacksPage x:Name="ModpacksTab" />
        </TabViewItem>
        <TabViewItem Header="玩家" IsClosable="False">
            <views:PlayersPage x:Name="PlayersTab" />
        </TabViewItem>
        <TabViewItem Header="穿透" IsClosable="False">
            <views:TunnelPage x:Name="TunnelTab" />
        </TabViewItem>
    </TabView>
</UserControl>
