<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.InstanceTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ceobe.App.Views">

    <!--
      实例页签容器。对齐 Java 版 MainView 的 TabPane。
      先只接「控制台」一页打通 VM↔XAML 管线并验证非打包 WinUI 3 能真启动；
      其余页签（服务器配置/游戏配置/Mod/整合包/玩家/穿透）随后逐个接入，
      避免一次性盲写多页 XAML 再撞一片难以定位的 WMC 错误。
    -->
    <TabView x:Name="Tabs" IsAddTabButtonVisible="False">
        <TabViewItem Header="控制台" IsClosable="False">
            <views:ConsolePage x:Name="ConsoleTab" />
        </TabViewItem>
    </TabView>
</UserControl>
