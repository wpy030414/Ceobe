<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ModpacksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ceobe.App.Controls"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="PackRowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </UserControl.Resources>

    <!--
      整合包页：两条路径并排写死——
      ① 装到当前实例（必须版本/加载器完全一致）；
      ② 按整合包新建实例（版本与加载器由包索引决定，用户不必自己判断）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="整合包" Margin="24,8,24,0"
                   Style="{StaticResource CeobeSectionTitleStyle}" />
    <Grid Grid.Row="1" Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 搜索 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="搜索 Modrinth 整合包…"
                     Text="{x:Bind Vm.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchKeyDown"
                     AutomationProperties.Name="搜索整合包" />
            <CheckBox Grid.Column="1" Content="仅显示适配本实例" VerticalAlignment="Center"
                      IsChecked="{x:Bind Vm.OnlyCompatible, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="搜索" Click="OnSearch"
                    IsEnabled="{x:Bind NotBusy, Mode=OneWay}" />
        </Grid>

        <!-- 结果表 -->
        <Border Grid.Row="1" Style="{StaticResource CeobeCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="12"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="名称"
                               Style="{StaticResource CeobeTableHeaderCellStyle}" />
                    <TextBlock Grid.Column="1" Text="标识"
                               Style="{StaticResource CeobeTableHeaderCellStyle}" />
                    <TextBlock Grid.Column="2" Text="作者"
                               Style="{StaticResource CeobeTableHeaderCellStyle}" />
                    <TextBlock Grid.Column="3" Text="下载"
                               Style="{StaticResource CeobeTableHeaderCellStyle}" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListView ItemsSource="{x:Bind Vm.Results, Mode=OneWay}"
                              SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource PackRowStyle}"
                              AutomationProperties.Name="整合包搜索结果">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModpackRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Categories}"
                                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Slug}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Author}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DownloadsLabel}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <controls:EmptyState Glyph="&#xE8B7;"
                                         Title="没有搜索结果"
                                         Description="输入关键词搜索 Modrinth 整合包；如果勾选了「仅显示适配本实例」，可以取消后再试。"
                                         Visibility="{x:Bind ShowEmptyResults, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 两条安装路径 -->
        <Border Grid.Row="2" Style="{StaticResource CeobeCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="怎么装？两条路，选一条" Style="{StaticResource CeobeSectionTitleStyle}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ① 装到本实例 -->
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="① 装到当前实例" Style="{StaticResource CeobeBodyStyle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="要求本实例的 MC 版本与加载器完全一致，否则会拦下并说清差异。"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}" TextWrapping="Wrap" />
                        <InfoBar IsOpen="{x:Bind ShowUnsupported, Mode=OneWay}"
                                 Severity="Warning" IsClosable="False"
                                 Title="{x:Bind Vm.UnsupportedHint, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Vm.InstallHereBlockedHint, Mode=OneWay}"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap" />
                        <Button Content="装到本实例" Click="OnInstallHere" HorizontalAlignment="Left"
                                IsEnabled="{x:Bind Vm.CanInstallHere, Mode=OneWay}" />
                    </StackPanel>

                    <!-- ② 新建并装 -->
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="② 按整合包新建一个实例" Style="{StaticResource CeobeBodyStyle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="版本与加载器由整合包索引决定，你不用自己选。"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}" TextWrapping="Wrap" />
                        <TextBox Header="新实例名" PlaceholderText="默认取整合包标识"
                                 Text="{x:Bind Vm.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="新实例名" />
                        <NumberBox Header="内存 (MB)" Value="{x:Bind NewMemoryMbDouble, Mode=TwoWay}"
                                   Minimum="1024" Maximum="32768" SmallChange="512"
                                   SpinButtonPlacementMode="Inline"
                                   AutomationProperties.Name="新实例内存" />
                        <Button Content="新建并安装" Click="OnCreateAndInstall" HorizontalAlignment="Left"
                                IsEnabled="{x:Bind Vm.CanCreateInstall, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Value="{x:Bind Vm.Progress, Mode=OneWay}" Maximum="1"
                             IsIndeterminate="{x:Bind ProgressIndeterminate, Mode=OneWay}"
                             Visibility="{x:Bind NotBusy, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{StaticResource CeobeCaptionSecondaryStyle}" />
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>
