<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ceobe.App.Controls"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <UserControl.Resources>
        <!-- 表头与行共用列宽/左右 padding，避免 ListViewItem 的默认内边距让列错位。 -->
        <Style x:Key="ModRowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </UserControl.Resources>

    <!--
      Mod 页：Modrinth 搜索/安装/卸载 + 一键导入（整改项 4）。
      两个 VM 各自独立、各自可单测（闸门 C）。原版/Paper 无 mods 目录时整页空状态。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Mod" Margin="24,8,24,0"
                   Style="{StaticResource CeobeSectionTitleStyle}" />
    <Grid Grid.Row="1" Padding="24,8,24,24" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
        <!-- 不支持模组时的整页说明 -->
        <controls:EmptyState Visibility="{x:Bind ShowUnsupported}"
                             Glyph="&#xE7BA;"
                             Title="此实例不支持模组"
                             Description="{x:Bind UnsupportedText}" />

        <Grid Visibility="{x:Bind ShowContent}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== 上：搜索 + 安装 ===== -->
            <Border Grid.Row="0" Style="{StaticResource CeobeCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="8"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" PlaceholderText="{x:Bind Vm.SearchHint}"
                                 Text="{x:Bind Vm.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnSearchKeyDown"
                                 AutomationProperties.Name="搜索 Modrinth" />
                        <ProgressRing Grid.Column="1" Width="20" Height="20"
                                      IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" />
                        <Button Grid.Column="2" Content="搜索" Click="OnSearch"
                                IsEnabled="{x:Bind NotBusy, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="16,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="名称"
                                       Style="{StaticResource CeobeTableHeaderCellStyle}" />
                            <TextBlock Grid.Column="1" Text="标识"
                                       Style="{StaticResource CeobeTableHeaderCellStyle}" />
                            <TextBlock Grid.Column="2" Text="作者"
                                       Style="{StaticResource CeobeTableHeaderCellStyle}" />
                            <TextBlock Grid.Column="3" Text="下载"
                                       Style="{StaticResource CeobeTableHeaderCellStyle}" />
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Results, Mode=OneWay}"
                                  SelectedItem="{x:Bind Vm.SelectedResult, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{StaticResource ModRowStyle}"
                                  AutomationProperties.Name="Modrinth 搜索结果">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModSearchRow">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Categories}"
                                                       Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Slug}"
                                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Author}"
                                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind DownloadsLabel}"
                                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Grid.Row="2" Content="安装所选" Click="OnInstall"
                                HorizontalAlignment="Left" Margin="16,8,16,12"
                                IsEnabled="{x:Bind Vm.CanInstall, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== 中：已安装 ===== -->
            <Border Grid.Row="1" Style="{StaticResource CeobeCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="8"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="已安装"
                                   Style="{StaticResource CeobeSectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="卸载所选" Click="OnUninstall"
                                IsEnabled="{x:Bind Vm.CanUninstall, Mode=OneWay}" />
                    </Grid>

                    <Grid Grid.Row="1" Padding="16,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文件"
                                   Style="{StaticResource CeobeTableHeaderCellStyle}" />
                        <TextBlock Grid.Column="1" Text="标题"
                                   Style="{StaticResource CeobeTableHeaderCellStyle}" />
                        <TextBlock Grid.Column="2" Text="环境"
                                   Style="{StaticResource CeobeTableHeaderCellStyle}" />
                        <TextBlock Grid.Column="3" Text="状态"
                                   Style="{StaticResource CeobeTableHeaderCellStyle}" />
                    </Grid>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind Vm.Installed, Mode=OneWay}"
                              SelectedItem="{x:Bind Vm.SelectedInstalled, Mode=TwoWay}"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource ModRowStyle}"
                              AutomationProperties.Name="已安装 Mod">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModInstalledRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind FileName}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind EnvLabel}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="12"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                  Visibility="{x:Bind Missing, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{x:Bind Present}"
                                                   Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ===== 下：一键导入（可折叠，避免挤占两个列表） ===== -->
            <Expander Grid.Row="2" Header="一键导入（.jar / .mrpack / .zip）"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Padding="0,4,0,0">
                    <TextBlock Text="把文件拖到本页任意处，或粘贴完整路径后点「识别」。识别只读，不会落盘。"
                               Style="{StaticResource CeobeSecondaryTextStyle}" TextWrapping="Wrap" />

                    <TextBox PlaceholderText="拖文件到本页，或在此粘贴完整路径"
                             Text="{x:Bind ImportVm.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="导入文件路径" />

                    <!-- 识别结果：种类 + 判定依据 + 匹配结论 + 落位 -->
                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ImportVm.Inspected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind ImportSummary, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ImportVm.MatchReason, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ImportVm.Notes, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 不匹配时给用户「强行导入」的显式出口（不静默放行） -->
                        <CheckBox Content="我确认要强行导入（忽略不匹配警告）"
                                  IsChecked="{x:Bind ImportVm.AllowMismatch, Mode=TwoWay}" />
                    </StackPanel>

                    <InfoBar IsOpen="{x:Bind HasBlockedReason, Mode=OneWay}"
                             Severity="Warning" IsClosable="False"
                             Title="{x:Bind ImportVm.BlockedReason, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="识别" Click="OnInspect" IsEnabled="{x:Bind NotBusy, Mode=OneWay}" />
                        <Button Content="导入" Click="OnImport"
                                IsEnabled="{x:Bind ImportVm.CanInstall, Mode=OneWay}" />
                        <Button Content="清空" Click="OnImportReset" />
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ImportVm.IsBusy, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
