<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <!--
      Mod 页：上半 Modrinth 搜索/安装/卸载（ModsViewModel），
      下半「一键导入」本地 jar/mrpack/zip（ImportViewModel，整改项 4）。
      两块共用一个页面是因为都在操作 mods/；VM 各自独立、各自可单测。
      原版/Paper 无 mods 目录时整页显示说明，不让用户点了才报错。
    -->
    <Grid Padding="20" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
        <!-- 不支持模组时的整页说明 -->
        <StackPanel Visibility="{x:Bind ShowUnsupported}" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="此实例不支持模组" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind UnsupportedText}" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Visibility="{x:Bind ShowContent}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 上：搜索 + 安装 ===== -->
            <Grid Grid.Row="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" PlaceholderText="{x:Bind Vm.SearchHint}"
                             Text="{x:Bind Vm.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown" />
                    <Button Grid.Column="1" Content="搜索" Click="OnSearch"
                            IsEnabled="{x:Bind NotBusy, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Results, Mode=OneWay}"
                          SelectedItem="{x:Bind Vm.SelectedResult, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="0,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="名称" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="标识" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="作者" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="下载" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModSearchRow">
                            <Grid ColumnSpacing="12" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="{x:Bind Title}" />
                                    <TextBlock Text="{x:Bind Categories}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Slug}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Author}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind DownloadsLabel}" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Grid.Row="2" Content="安装所选" Click="OnInstall" HorizontalAlignment="Left"
                        IsEnabled="{x:Bind Vm.CanInstall, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- ===== 下：已安装 + 一键导入 ===== -->
            <Grid Grid.Row="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="已安装" FontWeight="SemiBold" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Installed, Mode=OneWay}"
                          SelectedItem="{x:Bind Vm.SelectedInstalled, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModInstalledRow">
                            <Grid ColumnSpacing="12" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" /><ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind FileName}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{x:Bind EnvLabel}" FontSize="12" />
                                <!-- 「缺失」标红：mod 记录在但磁盘文件被删，是常见困惑源 -->
                                <TextBlock Grid.Column="3" Text="{x:Bind Present}" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Grid.Row="2" Content="卸载所选" Click="OnUninstall" HorizontalAlignment="Left"
                        IsEnabled="{x:Bind Vm.CanUninstall, Mode=OneWay}" />

                <!-- 一键导入（整改项 4）：选文件 → 识别预览 → 确认导入 -->
                <Border Grid.Row="3" Padding="12" CornerRadius="6" Margin="0,8,0,0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="一键导入（把 .jar / .mrpack / .zip 拖到本页任意处，或粘贴路径后点「识别」）"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <!-- 用拖拽 + 手填路径，不用 FileOpenPicker：
                             非打包 WinUI 3 下 FileOpenPicker 需要 HWND，UserControl 拿不到 Window 引用，
                             而拖拽是训练员点名的 PCL 式体验，两者都零 HWND 依赖 -->
                        <Border Padding="10" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <TextBox PlaceholderText="拖文件到本页，或在此粘贴完整路径"
                                     Text="{x:Bind ImportVm.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                        <!-- 识别结果：种类 + 判定依据 + 匹配结论 + 落位 -->
                        <StackPanel Spacing="4" Visibility="{x:Bind ImportVm.Inspected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Bind ImportSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ImportVm.MatchReason, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ImportVm.Notes, Mode=OneWay}">
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 不匹配时给用户「强行导入」的显式出口（不静默放行） -->
                            <CheckBox Content="我确认要强行导入（忽略不匹配警告）"
                                      IsChecked="{x:Bind ImportVm.AllowMismatch, Mode=TwoWay}" FontSize="12" />
                        </StackPanel>
                        <!-- 拦下时必须说清为什么不给按钮（BlockedReason），不能只置灰 -->
                        <TextBlock Text="{x:Bind ImportVm.BlockedReason, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="识别" Click="OnInspect" IsEnabled="{x:Bind NotBusy, Mode=OneWay}" />
                            <Button Content="导入" Click="OnImport" IsEnabled="{x:Bind ImportVm.CanInstall, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="清空" Click="OnImportReset" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
