<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.PlayersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <!--
      玩家页（整改项 2：训练员原话「白名单默认开启，但没有入口填写白名单，
      只能在控制台输入指令，建议给玩家页面单开一页」）。

      设计要点：
      · 白名单开关放在最顶上——它是「谁能进服」的安全开关，必须第一眼看到；
      · 四个名单（白名单/OP/封禁玩家/封禁IP）用单选分段，一次只看一张表，不堆成一坨；
      · 运行中的改动走服务端命令热生效，停机时才本地写文件——两者的后果在状态栏如实区分。
    -->
    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="玩家" FontSize="18" FontWeight="SemiBold" />

        <!-- 白名单状态（安全开关） -->
        <Border Grid.Row="1" Padding="12" CornerRadius="6"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <CheckBox Content="启用白名单（只有名单内玩家能进入）"
                              IsChecked="{x:Bind Vm.WhitelistEnabled, Mode=TwoWay}"
                              Click="OnToggleWhitelist" />
                    <CheckBox Content="强制白名单（踢出未在名单中的在线玩家）"
                              IsChecked="{x:Bind Vm.EnforceWhitelist, Mode=TwoWay}"
                              Click="OnToggleEnforce" />
                </StackPanel>
                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <RadioButtons Grid.Row="2" MaxColumns="4" SelectedIndex="{x:Bind SectionIndex, Mode=TwoWay}">
            <RadioButton Content="白名单" />
            <RadioButton Content="管理员 OP" />
            <RadioButton Content="封禁玩家" />
            <RadioButton Content="封禁 IP" />
        </RadioButtons>

        <!-- ===== 白名单 ===== -->
        <Grid Grid.Row="3" RowSpacing="8"
              Visibility="{x:Bind WlVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" PlaceholderText="玩家名（离线模式按名算 UUID，正版模式查 Mojang）"
                         Text="{x:Bind Vm.NewPlayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="加入白名单" Click="OnAddWhitelist"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Whitelist, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WhitelistRow">
                        <Grid ColumnSpacing="12" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Uuid}" FontSize="11"
                                       VerticalAlignment="Center" FontFamily="Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Grid.Column="2" Content="移除" Tag="{x:Bind Name}" Click="OnRemoveWhitelist" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Expander Grid.Row="2" Header="批量导入（逗号 / 换行 / 空格分隔）" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,6,0,0">
                    <TextBox x:Name="BulkBox" AcceptsReturn="True" Height="76" TextWrapping="Wrap"
                             PlaceholderText="Steve, Alex, Notch" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导入这些玩家" Click="OnImportWhitelist" />
                        <Button Content="从 OP 列表导入" Click="OnImportFromOps" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </Grid>

        <!-- ===== OP ===== -->
        <Grid Grid.Row="3" RowSpacing="8"
              Visibility="{x:Bind OpVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" PlaceholderText="玩家名"
                         Text="{x:Bind Vm.NewPlayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" Width="120" SelectedIndex="{x:Bind OpLevelIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="等级 1" />
                    <ComboBoxItem Content="等级 2" />
                    <ComboBoxItem Content="等级 3" />
                    <ComboBoxItem Content="等级 4（默认）" />
                </ComboBox>
                <Button Grid.Column="2" Content="设为 OP" Click="OnAddOp"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Ops, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpRow">
                        <Grid ColumnSpacing="12" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Uuid}" FontSize="11"
                                       VerticalAlignment="Center" FontFamily="Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Level}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="移除" Tag="{x:Bind Name}" Click="OnRemoveOp" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ===== 封禁玩家 ===== -->
        <Grid Grid.Row="3" RowSpacing="8"
              Visibility="{x:Bind BanVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" PlaceholderText="要封禁的玩家名"
                         Text="{x:Bind Vm.NewPlayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="封禁" Click="OnBanPlayer" />
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.BannedPlayers, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BanRow">
                        <Grid ColumnSpacing="12" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Uuid}" FontSize="11"
                                       VerticalAlignment="Center" FontFamily="Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Expires}" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="解除" Tag="{x:Bind Name}" Click="OnPardonPlayer" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ===== 封禁 IP ===== -->
        <Grid Grid.Row="3" RowSpacing="8"
              Visibility="{x:Bind IpBanVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" PlaceholderText="要封禁的 IP，如 192.168.1.33"
                         Text="{x:Bind Vm.NewIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="封禁 IP" Click="OnBanIp" />
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.BannedIps, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:IpBanRow">
                        <Grid ColumnSpacing="12" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Ip}" FontFamily="Consolas" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Expires}" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="解除" Tag="{x:Bind Ip}" Click="OnPardonIp" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <InfoBar Grid.Row="4" IsOpen="{x:Bind Vm.HasError, Mode=OneWay}" Severity="Error"
                 IsClosable="False" Title="操作未完成"
                 Message="{x:Bind Vm.StatusText, Mode=OneWay}" />
    </Grid>
</UserControl>
