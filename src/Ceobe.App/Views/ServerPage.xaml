<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
      服务器配置页：实例级设置（名称/内存/端口/JVM/authlib），落 instance.json。
      与「游戏配置」页分工——本页不碰 server.properties，避免两页互相覆盖。
      运行中禁止修改（改了不生效会让用户误判）。业务在 ServerViewModel（闸门 C 可单测）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="服务器配置" Margin="24,8,24,0"
                   Style="{StaticResource CeobeSectionTitleStyle}" />
    <Grid Grid.Row="1" Padding="24,8,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 运行中提示：醒目但不吓人 -->
        <InfoBar Grid.Row="0"
                 IsOpen="{x:Bind Vm.ServerRunning, Mode=OneWay}"
                 Severity="Warning" IsClosable="False"
                 Title="{x:Bind Vm.RunningHint, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4" MaxWidth="{StaticResource CeobeFormMaxWidth}"
                        HorizontalAlignment="Left">

                <controls:SettingsCard Header="实例名"
                                       Description="小写字母/数字/_/-；保存后会同步重命名实例目录。"
                                       ContentAlignment="Right">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox Width="280"
                             Text="{x:Bind Vm.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}"
                             AutomationProperties.Name="实例名" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="内存上限 (MB)"
                                       Description="分配给服务端 JVM 的最大堆内存。"
                                       ContentAlignment="Right">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE950;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox Width="180"
                               Value="{x:Bind Vm.MemoryMb, Mode=TwoWay}"
                               Minimum="{x:Bind Vm.MemoryMin}" Maximum="{x:Bind Vm.MemoryMax}"
                               SpinButtonPlacementMode="Inline" SmallChange="512" LargeChange="1024"
                               IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}"
                               AutomationProperties.Name="内存上限（MB）" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="服务器端口"
                                       Description="改动会同步 server.properties 的 server-port / query.port；穿透通道也会指向新端口。"
                                       ContentAlignment="Right">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox Width="180"
                               Value="{x:Bind Vm.Port, Mode=TwoWay}"
                               Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline"
                               IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}"
                               AutomationProperties.Name="服务器端口" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="附加 JVM 参数"
                                       Description="可留空。例：-XX:+UseZGC"
                                       ContentAlignment="Right">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE756;" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox Width="320" PlaceholderText="如 -XX:+UseZGC"
                             Text="{x:Bind Vm.JvmArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}"
                             AutomationProperties.Name="附加 JVM 参数" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="authlib-injector"
                                       Description="填 Yggdrasil API 地址即启用三方鉴权，并自动关闭正版验证（online-mode）。留空 = 关闭。"
                                       ContentAlignment="Right">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBox Width="320" PlaceholderText="如 https://littleskin.cn/api/yggdrasil"
                             Text="{x:Bind Vm.AuthlibInjectorUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}"
                             AutomationProperties.Name="authlib-injector 地址" />
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作条：保存是唯一 Accent -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       Style="{StaticResource CeobeCaptionSecondaryStyle}" />

            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                       Text="未保存" Style="{StaticResource CeobeCaptionSecondaryStyle}"
                       Visibility="{x:Bind Vm.IsDirty, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <Button Grid.Column="2" Content="放弃" Click="OnDiscard"
                    IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}" />
            <Button Grid.Column="3" Content="保存" Click="OnSave"
                    IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
    </Grid>
</UserControl>
