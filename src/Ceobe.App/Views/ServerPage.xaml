<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      服务器配置页：实例级设置（名称/内存/端口/JVM/authlib），落 instance.json。
      与「游戏配置」页分工——本页不碰 server.properties，避免两页互相覆盖。
      运行中禁止修改（改了不生效会让用户误判）。业务在 ServerViewModel（闸门 C 可单测）。
    -->
    <Grid RowSpacing="12" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="服务器配置" FontSize="18" FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
                <!-- 运行中提示：醒目但不吓人 -->
                <InfoBar IsOpen="{x:Bind Vm.ServerRunning, Mode=OneWay}"
                         Severity="Warning" IsClosable="False"
                         Title="{x:Bind Vm.RunningHint, Mode=OneWay}" />

                <TextBox Header="实例名（小写字母/数字/_/-）"
                         Text="{x:Bind Vm.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}" />

                <NumberBox Header="内存上限 (MB)" Value="{x:Bind Vm.MemoryMb, Mode=TwoWay}"
                           Minimum="{x:Bind Vm.MemoryMin}" Maximum="{x:Bind Vm.MemoryMax}"
                           SpinButtonPlacementMode="Inline" SmallChange="512" LargeChange="1024"
                           IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}" />

                <NumberBox Header="服务器端口（改动会同步 server.properties）"
                           Value="{x:Bind Vm.Port, Mode=TwoWay}"
                           Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline"
                           IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}" />

                <TextBox Header="附加 JVM 参数（可留空）"
                         PlaceholderText="如 -XX:+UseZGC"
                         Text="{x:Bind Vm.JvmArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}" />

                <TextBox Header="authlib-injector（Yggdrasil API 地址，留空=关闭正版验证三方鉴权）"
                         PlaceholderText="如 https://littleskin.cn/api/yggdrasil"
                         Text="{x:Bind Vm.AuthlibInjectorUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}" />

                <TextBlock FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="填入 authlib-injector 地址即启用三方鉴权，会自动关闭正版验证（online-mode）。改端口会同步 server.properties 的 server-port/query.port——穿透通道指向该端口。" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作条 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="放弃" Click="OnDiscard"
                    IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}" />
            <Button Grid.Column="2" Content="保存" Click="OnSave"
                    IsEnabled="{x:Bind Vm.CanSave, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
