<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ceobe.App.Views.TunnelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ceobe.App.Controls"
    xmlns:vm="using:Ceobe.App.ViewModels">

    <!--
      穿透页（整改项 1）：这一页的产品核心不是「开关」，而是把结论说清楚。
      每条通道都要有「已实测可达 / 无法验证 / 未探测」三态，并且 server-ip 绑定冲突
      要在开启之前就警告——那正是「本地能连、外部连不上」最常见的原因。
    -->
    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0" Severity="Warning" IsClosable="False"
                 IsOpen="{x:Bind HasBindingWarning, Mode=OneWay}"
                 Title="server-ip 与穿透通道冲突"
                 Message="{x:Bind Vm.BindingWarning, Mode=OneWay}" />

        <InfoBar Grid.Row="1" Severity="Error" IsClosable="True"
                 IsOpen="{x:Bind Vm.HasError, Mode=OneWay}"
                 Title="操作未完成"
                 Message="{x:Bind Vm.StatusText, Mode=OneWay}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind Vm.Cards, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TunnelCard">
                        <Border Style="{StaticResource CeobeCardStyle}" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <!-- 标题行 -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                               Style="{StaticResource CeobeSectionTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <controls:VerdictIcon Grid.Column="1"
                                                          Verdict="{x:Bind Verified, Mode=OneWay}"
                                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind VerdictLabel, Mode=OneWay}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind StateLabel, Mode=OneWay}"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- 地址行 -->
                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Padding="12,8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Address, Mode=OneWay}"
                                                   FontFamily="{StaticResource CeobeMonoFont}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsTextSelectionEnabled="True"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind IsUp, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="0" Text="尚未开启"
                                                   Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind IsUp, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                        <Button Grid.Column="1" Content="复制"
                                                Tag="{x:Bind Address, Mode=OneWay}" Click="OnCopy"
                                                IsEnabled="{x:Bind IsUp, Mode=OneWay}"
                                                AutomationProperties.Name="复制隧道地址" />
                                    </Grid>
                                </Border>

                                <!-- 说明 + 轮换警告 -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Note, Mode=OneWay}" TextWrapping="Wrap"
                                               Style="{StaticResource CeobeCaptionSecondaryStyle}" />
                                    <TextBlock Text="地址已轮换，请重新分享给朋友（他们存的旧地址已失效）。"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Visibility="{x:Bind AddressRotated, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <Expander Header="诊断详情" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <TextBlock Text="{x:Bind Diagnostic, Mode=OneWay}" FontSize="12"
                                               FontFamily="{StaticResource CeobeMonoFont}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Expander>

                                <TextBlock Text="局域网直连，无需开关。"
                                           Style="{StaticResource CeobeCaptionSecondaryStyle}"
                                           Visibility="{x:Bind AlwaysAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Button Content="{x:Bind ToggleLabel, Mode=OneWay}"
                                        Tag="{x:Bind Kind}" Click="OnToggle"
                                        IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                        HorizontalAlignment="Left"
                                        Visibility="{x:Bind AlwaysAvailable, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
