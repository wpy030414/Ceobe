<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Ceobe.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      网络用例（ProviderNetworkTest，Trait Category=network）默认不跑：
      它们会真实下载服务端 jar / JDK，几十分钟且受网络环境影响，
      与 Java 版 @Tag("network") 的语义保持一致。
      显式跑：dotnet test 加 filter 参数 "Category=network"。
      这里加条件是为了不覆盖命令行传进来的 filter。
    -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=network</VSTestTestCaseFilter>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ceobe.Core\Ceobe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK 项目默认不复制 None 项；缺这条 xunit 读不到配置，collection 级并行仍会串扰全局静态 -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!--
      闸门 B 真值 fixture：由 tools/wiregen/Gen.java 用**真实 Jackson + 真实 Java 模型类**生成，
      不是手打样本。Java 侧模型字段变更时需重跑生成器（见 Gen.java 的 javac/java 命令）。
    -->
    <None Update="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
