<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Ceobe.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ceobe.Core\Ceobe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK 项目默认不复制 None 项；缺这条 xunit 读不到配置，collection 级并行仍会串扰全局静态 -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!--
      闸门 B 真值 fixture：由 tools/wiregen/Gen.java 用**真实 Jackson + 真实 Java 模型类**生成，
      不是手打样本。Java 侧模型字段变更时需重跑生成器（见 Gen.java 的 javac/java 命令）。
    -->
    <None Update="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
